<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp1"
             x:Class="MauiApp1.ThirdPage"
             Padding="0,50"
             BackgroundColor="LightGreen">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20">

        <!-- Back Button -->
        <Button Text="←"
                BackgroundColor="Gray"
                TextColor="White"
                WidthRequest="50"
                Grid.Row="0"
                Margin="0,-30,250,0"
                Clicked="OnBackClicked" />

        <!-- Entry -->
        <Entry x:Name="UserInput"
               Placeholder="Type something..."
               FontSize="18"
               Grid.Row="1" />

        <!-- Add Button -->
        <Button Text="Add to List"
                Clicked="OnAddClicked"
                BackgroundColor="DarkGreen"
                TextColor="White"
                Grid.Row="2" />

        <!-- Scrollable List -->
        <CollectionView ItemsSource="{x:Static local:DataStore.Items}"
                Grid.Row="3">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" BackgroundColor="White">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{Binding}" FontSize="20" VerticalOptions="Center" />
                            <Button Text="Delete"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    BindingContext="{Binding}"
                                    Clicked="OnDeleteClicked" />
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
